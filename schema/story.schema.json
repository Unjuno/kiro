{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KIRO v2 story metadata",
  "type": "object",
  "required": ["schema_version", "id", "version", "title", "language", "authors", "entries", "source_url", "attribution", "rights", "localization", "statistics"],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"},
    "version": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "title": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "authors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "entries": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["id", "label"], "properties": {"id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}}}
    },
    "source_url": {"type": "string", "format": "uri"},
    "attribution": {"type": "string", "minLength": 1},
    "rights": {"type": "object", "required": ["original_work", "verified_territories", "worldwide_clearance", "note"]},
    "localization": {"type": "object", "required": ["mode", "use_session_language"], "properties": {"mode": {"const": "agent-runtime"}, "use_session_language": {"const": true}}},
    "statistics": {"type": "object", "required": ["nodes", "edges", "endings"]},
    "test_fixture": {"type": "boolean"}
  }
}
