{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiro.local/schema/story.schema.json",
  "title": "KIRO Story Metadata",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "language",
    "entry_node",
    "origin",
    "rights",
    "localization",
    "voice"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "description": "Canonical/source language of the ported story text."
    },
    "entry_node": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "origin": {
      "type": "object",
      "required": ["original_title", "authors", "source_url", "source_type"],
      "properties": {
        "original_title": { "type": "string" },
        "authors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "public-domain",
            "creative-commons",
            "licensed",
            "original",
            "other"
          ]
        }
      }
    },
    "rights": {
      "type": "object",
      "required": ["status", "attribution_required"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["unverified", "verified", "restricted"]
        },
        "license": {
          "type": ["string", "null"]
        },
        "jurisdiction_notes": {
          "type": "string"
        },
        "attribution_required": {
          "type": "boolean"
        }
      }
    },
    "localization": {
      "type": "object",
      "required": [
        "mode",
        "ask_player_language_before_play",
        "fallback_language",
        "preserve_original_names",
        "instructions"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["source-only", "agent-runtime", "pretranslated"]
        },
        "ask_player_language_before_play": {
          "type": "boolean"
        },
        "fallback_language": {
          "type": "string",
          "minLength": 2
        },
        "preserve_original_names": {
          "type": "boolean"
        },
        "instructions": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "voice": {
      "type": "object",
      "required": [
        "announce_origin_before_play",
        "origin_announcement",
        "translate_origin_announcement"
      ],
      "properties": {
        "announce_origin_before_play": {
          "type": "boolean"
        },
        "origin_announcement": {
          "type": "string"
        },
        "translate_origin_announcement": {
          "type": "boolean"
        }
      }
    }
  }
}
